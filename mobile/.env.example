# Copia este archivo como .env (en esta misma carpeta mobile/) y llénalo.

# Mientras dure la migración (Fase 2 de docs/plan.md) la app sigue usando Supabase.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# API NestJS en tu computadora. Con Expo Go el teléfono no entiende "localhost":
# usa la IP de tu PC en la red Wi-Fi (en Windows: ipconfig → "Dirección IPv4").
EXPO_PUBLIC_API_URL=http://192.168.1.100:3000
