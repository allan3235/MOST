// Mapa de la base de most. Las funciones SQL (recompensas), los disparadores, las restricciones
// CHECK y las políticas RLS no se dibujan aquí: viven en el SQL de prisma/migrations.
// Cómo cambiar la base: edita este archivo → pnpm db:nueva-migracion --name <nombre> → revisa y
// completa el SQL generado → pnpm db:migrar. (Si "prisma db pull" reescribe el archivo, vuelve a
// poner este comentario.)

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "public"]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model usuarios {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  correo          String       @unique
  hash_contrasena String
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  updated_at      DateTime     @default(now()) @db.Timestamptz(6)
  categories      categories[]
  profiles        profiles?

  @@schema("auth")
}

