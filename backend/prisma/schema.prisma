/// Secuencia ordenada de micro-pasos de un hábito (RF-03), de menor a mayor esfuerzo. La genera la
/// IA (o el catálogo si la IA falla). duracion_min = 0 significa recordatorio sin duración.
/// Restricciones CHECK y políticas RLS en la migración 20261123080815_micro_pasos.
model micro_pasos {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  habit_id              String   @db.Uuid
  user_id               String   @db.Uuid
  orden                 Int      @db.SmallInt
  titulo                String
  descripcion           String?
  duracion_min          Int
  duracion_reducida_min Int
  dias_semana           Int[]    @db.SmallInt
  created_at            DateTime @default(now()) @db.Timestamptz(6)
  updated_at            DateTime @default(now()) @db.Timestamptz(6)
  habits                habits   @relation(fields: [habit_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles              profiles @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([habit_id, orden])
  @@index([user_id, updated_at], map: "micro_pasos_user_updated_idx")
  @@schema("public")
}

/// Periodos en que un hábito estuvo en pausa (RF-09): esos días no cuentan como fallo. hasta = null
/// mientras sigue en pausa. Restricciones CHECK y políticas RLS en la migración
/// 20261123130000_habit_pausas.
model habit_pausas {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  habit_id   String    @db.Uuid
  user_id    String    @db.Uuid
  desde      DateTime  @db.Date
  hasta      DateTime? @db.Date
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @db.Timestamptz(6)
  habits     habits    @relation(fields: [habit_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles   profiles  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([habit_id], map: "habit_pausas_habit_idx")
  @@index([user_id, updated_at], map: "habit_pausas_user_updated_idx")
  @@schema("public")
}
