# Copia este archivo como .env (en esta misma carpeta backend/).

# Base local de docker-compose.yml (docker compose up -d).
DATABASE_URL=postgresql://most:most@localhost:5433/most

# Secreto para firmar los tokens de sesión: una cadena larga y aleatoria (32 caracteres o más).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRETO=

# Duración del token de sesión (60 días, igual que el límite sin conexión de la app).
JWT_EXPIRA=60d

PUERTO=3001

# IA (Claude). Clave de https://platform.claude.com → API keys. Sin ella, los planes salen del
# catálogo y "Crear meta" responde que la IA no está disponible. NUNCA la subas al repositorio.
ANTHROPIC_API_KEY=
# Modelo grande (crear planes y descomponer metas) y pequeño (ajustes cortos). Opcionales.
# IA_MODELO_GRANDE=claude-opus-5-5
# IA_MODELO_PEQUENO=claude-haiku-5-5
# Llamadas a la IA por usuario al día (opcional, 10 por defecto).
# IA_LIMITE_DIARIO=10
